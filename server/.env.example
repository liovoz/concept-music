## Device platform
## lite: KuGou concept/lite mode
platform=lite

## Server port
PORT='10420'

## Optional HTTP proxy for upstream KuGou requests
KUGOU_API_PROXY=''

## Optional fixed device identifiers
## KUGOU_API_GUID is usually a uuidv4 value
## KUGOU_API_DEV is usually a 10-character string
KUGOU_API_GUID=''
KUGOU_API_DEV=''
KUGOU_API_MAC=''

## Optional WeChat login secrets.
## Keep real values in .env only. Do not commit them to GitHub.
KUGOU_WX_SECRET=''
KUGOU_WX_LITE_SECRET=''
